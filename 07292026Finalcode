# =========================
# GUI UPDATE
# =========================
def update_monitor():
    global runtime_seconds
    global downtime_seconds
    global stops
    global last_status
    global last_update_time
    global save_elapsed_seconds

    current = read_current()

    now = time.monotonic()
    elapsed = now - last_update_time
    last_update_time = now

    if elapsed < 0:
        elapsed = 0
    if elapsed > 10:
        elapsed = 10

    current_samples.append(current)
    status, alarm = get_machine_status(current)

    if status in ("RUN", "OVERCURRENT"):
        runtime_seconds += elapsed
    else:
        downtime_seconds += elapsed

    if (
        last_status in ("RUN", "OVERCURRENT")
        and status == "STOP"
    ):
        stops += 1

    last_status = status
    save_elapsed_seconds += elapsed

    remaining = max(
        0,
        SAVE_INTERVAL_SECONDS
        - save_elapsed_seconds
    )

    status_value.setText("● " + status)
    current_value.setText(
        "{:.3f} A".format(current)
    )
    runtime_value.setText(
        format_time(runtime_seconds)
    )
    downtime_value.setText(
        format_time(downtime_seconds)
    )
    stops_value.setText(str(stops))
    alarm_value.setText(alarm)

    save_value.setText(
        "Next save: {:02}:{:02}".format(
            int(remaining) // 60,
            int(remaining) % 60
        )
    )

    status_colours = {
        "RUN": "#4cd137",
        "OVERCURRENT": "#ff8c00",
        "STOP": "#ff4d4d"
    }

    alarm_colours = {
        "NORMAL": "#4cd137",
        "ON": "#fbc531",
        "OVERCURRENT": "#ff4d4d",
        "OFF": "#5dade2"
    }

    status_value.setStyleSheet(
        "color: {};"
        "background: transparent;".format(
            status_colours.get(
                status,
                "#ffffff"
            )
        )
    )

    alarm_value.setStyleSheet(
        "color: {};"
        "background: transparent;".format(
            alarm_colours.get(
                alarm,
                "#ffffff"
            )
        )
    )

    if save_elapsed_seconds >= SAVE_INTERVAL_SECONDS:
        save_interval_data()


def manual_save():
