# =========================
def save_interval_data():
    global current_samples
    global save_elapsed_seconds

    if not current_samples:
        save_button.setText("No Samples Yet")
        return

    avg_current = (
        sum(current_samples) / len(current_samples)
    )
    max_current = max(current_samples)
    min_current = min(current_samples)

    status, alarm = get_machine_status(
        avg_current
    )

    runtime_text = format_time(runtime_seconds)
    downtime_text = format_time(downtime_seconds)

    try:
        save_to_sqlite(
            local_timestamp(),
            avg_current,
            max_current,
            min_current,
            status,
            runtime_text,
            downtime_text,
            stops,
            alarm
        )
        export_csv()
        local_saved = True
    except Exception as error:
        print("Local save/export error:", error)
        local_saved = False

    if local_saved:
        last_save_value.setText(
            "Last save: {}".format(
                datetime.now().strftime("%H:%M:%S")
            )
        )
        local_value.setText(
            "Local: SQLite + CSV saved"
        )
        local_value.setStyleSheet(
            "color: #4cd137;"
            "background: transparent;"
        )
        save_button.setText("Saved Locally")

        payload = {
            "timestamp": online_timestamp(),
            "avg_current": round(avg_current, 2),
            "max_current": round(max_current, 2),
            "min_current": round(min_current, 2),
            "status": status,
            "runtime": runtime_text,
            "downtime": downtime_text,
            "stops": stops,
            "alarm": alarm
        }

        if supabase_is_configured():
            cloud_value.setText("Cloud: Uploading...")
            cloud_value.setStyleSheet(
                "color: #fbc531;"
                "background: transparent;"
            )
            if not start_supabase_upload(payload):
                cloud_value.setText(
                    "Cloud: Upload Busy"
                )
        else:
            cloud_value.setText(
                "Cloud: Key Not Configured"
            )
            cloud_value.setStyleSheet(
                "color: #fbc531;"
                "background: transparent;"
            )
            save_button.setText(
                "Saved Local Only"
            )
    else:
        local_value.setText("Local: Save Failed")
        local_value.setStyleSheet(
            "color: #ff4d4d;"
            "background: transparent;"
        )
        save_button.setText("Save Failed")

    current_samples = []
    save_elapsed_seconds = 0.0


