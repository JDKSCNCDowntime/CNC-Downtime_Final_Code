# SQLITE
# =========================
def setup_database():
    with sqlite3.connect(DB_FILE) as connection:
        connection.execute("""
            CREATE TABLE IF NOT EXISTS machine_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT NOT NULL,
                avg_current REAL,
                max_current REAL,
                min_current REAL,
                status TEXT,
                runtime TEXT,
                downtime TEXT,
                stops INTEGER,
                alarm TEXT
            )
        """)


def save_to_sqlite(
    timestamp,
    avg_current,
    max_current,
    min_current,
    status,
    runtime,
    downtime,
    stop_count,
    alarm
):
    with sqlite3.connect(DB_FILE) as connection:
        connection.execute("""
            INSERT INTO machine_log (
                timestamp,
                avg_current,
                max_current,
                min_current,
                status,
                runtime,
                downtime,
                stops,
                alarm
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            timestamp,
            round(avg_current, 2),
            round(max_current, 2),
            round(min_current, 2),
            status,
            runtime,
            downtime,
            stop_count,
            alarm
        ))


def export_csv():
    with sqlite3.connect(DB_FILE) as connection:
        rows = connection.execute("""
            SELECT
                id,
                timestamp,
                avg_current,
                max_current,
                min_current,
                status,
                runtime,
                downtime,
                stops,
                alarm
            FROM machine_log
            ORDER BY id ASC
        """).fetchall()

    with open(CSV_FILE, "w", newline="") as file:
        writer = csv.writer(file)
        writer.writerow([
            "ID",
            "Timestamp",
            "Average Current (A)",
            "Max Current (A)",
            "Min Current (A)",
            "Status",
            "Runtime",
            "Downtime",
            "Stops",
            "Alarm"
        ])
        writer.writerows(rows)


# =========================
# SUPABASE
# =========================
def supabase_is_configured():
    return bool(
        SUPABASE_KEY
        and SUPABASE_KEY != "PASTE_YOUR_SUPABASE_KEY_HERE"
    )


def upload_payload_to_supabase(payload):
    if not supabase_is_configured():
        return False, "Supabase key not configured"

    url = "{}/rest/v1/{}".format(
        SUPABASE_URL.rstrip("/"),
        SUPABASE_TABLE
    )

    request = Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        method="POST"
    )
    request.add_header("apikey", SUPABASE_KEY)

    if SUPABASE_KEY.startswith("eyJ"):
        request.add_header(
            "Authorization",
            "Bearer " + SUPABASE_KEY
        )

    request.add_header(
        "Content-Type",
        "application/json"
    )
    request.add_header(
        "Prefer",
        "return=minimal"
    )

    try:
        context = ssl.create_default_context()
        with urlopen(
            request,
            timeout=15,
            context=context
        ) as response:
            ok = response.status in (200, 201, 204)
            return ok, "HTTP {}".format(response.status)

    except HTTPError as error:
        try:
            details = error.read().decode("utf-8")
        except Exception:
            details = str(error)
        return False, "HTTP {}: {}".format(
            error.code,
            details
        )

    except URLError as error:
        return False, "Network/SSL: {}".format(
            error.reason
        )

    except Exception as error:
        return False, str(error)


def upload_worker(payload):
    global upload_in_progress
    success, message = upload_payload_to_supabase(
        payload
    )
    upload_results.put((success, message))
    upload_in_progress = False


def start_supabase_upload(payload):
    global upload_in_progress

    if upload_in_progress:
        print("Previous upload is still running.")
        return False

    upload_in_progress = True
    thread = threading.Thread(
        target=upload_worker,
        args=(payload,)
    )
    thread.daemon = True
    thread.start()
    return True


def check_upload_results():
    try:
        while True:
            success, message = upload_results.get_nowait()

            if success:
                cloud_value.setText("Cloud: Uploaded")
                cloud_value.setStyleSheet(
                    "color: #4cd137;"
                    "background: transparent;"
                )
                save_button.setText(
                    "Saved + Uploaded"
                )
            else:
                cloud_value.setText(
                    "Cloud: Upload Failed"
                )
                cloud_value.setStyleSheet(
                    "color: #ff4d4d;"
                    "background: transparent;"
                )
                save_button.setText(
                    "Saved Local Only"
                )

            print("Supabase:", success, message)

    except queue.Empty:
        pass


